{
  "appId": "com.translinkinternasional.tlinet.admin",
  "appName": "TLINET Admin",
  "webDir": "www",
  "appendUserAgent": "TLINETAdminApp/1.0",
  "backgroundColor": "#ffffff",
  "server": {
    "url": "https://www.translinkinternasional.com/admin",
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "contain",
      "style": "LIGHT"
    }
  }
}
