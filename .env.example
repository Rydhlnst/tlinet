# ─────────────────────────────────────────────────────────────────────────────
# TLINET (PT Trans Link Internasional) — contoh environment
#
# Cara pakai:
#   • Pengembangan lokal : salin file ini jadi `.env.local`, lalu isi nilainya.
#   • Server (srv1)      : salin jadi `.env`, isi nilainya, lalu restart (pm2 restart tlinet).
#
# File CONTOH ini TIDAK berisi rahasia — isi sendiri nilai yang kosong.
# JANGAN commit `.env` / `.env.local` yang sudah berisi nilai asli.
# Setelah mengubah env, server WAJIB di-restart agar terbaca.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database (WAJIB) ─────────────────────────────────────────────────────────
# Connection string Neon Postgres (mode pooled). Ambil dari dashboard Neon.
DATABASE_URL=

# ── Keamanan & login admin (WAJIB) ───────────────────────────────────────────
# Kunci rahasia penanda-tangan cookie sesi (admin, portal Subnet, tautan invoice).
# Buat acak, mis.: openssl rand -hex 32   (jangan diganti setelah dipakai, nanti semua sesi logout).
SESSION_SECRET=
# Akun owner dashboard. Password minimal 8 karakter.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Alamat situs (disarankan) ────────────────────────────────────────────────
# URL publik lengkap situs, untuk membentuk tautan absolut (mis. link invoice di WhatsApp).
# Contoh: https://translinkinternasional.com
NEXT_PUBLIC_SITE_URL=


# ── Penyimpanan media: Cloudflare R2 (opsional) ──────────────────────────────
# Jika KOSONG, unggahan gambar/PDF disimpan di database Neon (fallback otomatis).
# Isi semua agar memakai R2. Nilai non-rahasia sudah diisi; lengkapi kunci rahasianya.
R2_ACCOUNT_ID=
R2_BUCKET=tlinet
# URL publik bucket (r2.dev atau domain kustom). Hanya alamat ini yang boleh lewat pengoptimal gambar.
R2_PUBLIC_URL=https://pub-7755b913f9b14072967cbd0b06d0415e.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opsional: endpoint S3 R2 kustom. Kosongkan untuk pakai bawaan dari R2_ACCOUNT_ID.
R2_ENDPOINT=
# Opsional: origin tambahan yang diizinkan pengoptimal gambar (selain R2_PUBLIC_URL), mis. CDN lain.
CMS_IMAGE_ORIGIN=


# ── LibreNMS / MRTG — grafik trafik Subnet (opsional) ────────────────────────
# Token API LibreNMS (hanya dipakai di server) untuk grafik trafik per port pelanggan.
API_LIBRE_NMS=
# URL LibreNMS. Kosongkan untuk bawaan https://mrtg.translinkinternasional.com
LIBRENMS_URL=https://mrtg.translinkinternasional.com
# Akun web LibreNMS (global-read) untuk grafik REAL-TIME yang butuh sesi login, mis. user "subnet-portal".
LIBRENMS_USERNAME=
LIBRENMS_PASSWORD=


# ── Accurate Online — pencatatan akuntansi (opsional) ────────────────────────
# Kredensial integrasi Accurate. Kosongkan bila belum dipakai.
ACCURATE_API_TOKEN=
ACCURATE_SIGNATURE_SECRET=
# Set "on" untuk mengizinkan tulis ke Accurate dari dashboard; selain itu hanya baca.
ACCURATE_WRITE=


# ── Asisten AI (MiMo) — panel chat admin (opsional) ──────────────────────────
# Isi KETIGANYA untuk mengaktifkan panel chat AI di dashboard. Kosong = panel tampil "AI belum aktif".
# MIMO_API_URL = URL endpoint chat completions PENUH (OpenAI-compatible), mis. https://.../v1/chat/completions
MIMO_API_URL=
MIMO_MODEL=
MIMO_API_KEY=


# ── Diisi otomatis oleh runtime — JANGAN ditulis di sini ─────────────────────
# NODE_ENV                      → diset otomatis (development/production).
# VERCEL_PROJECT_PRODUCTION_URL → diisi Vercel otomatis saat deploy di Vercel.
