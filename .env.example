# Alamat publik situs (tanpa garis miring di akhir), dipakai untuk URL kanonis, sitemap, dan Open Graph.
NEXT_PUBLIC_SITE_URL="https://example.com"

DATABASE_URL=""
SESSION_SECRET=""
# Akun admin awal, dipakai oleh `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Cloudflare R2 (opsional). Jika salah satu kosong, unggahan disimpan di database (tabel media_assets).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# URL publik bucket, mis. https://pub-xxxx.r2.dev atau domain kustom
R2_PUBLIC_URL=""
# Opsional: endpoint S3 selain bawaan, mis. https://<account>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=""
